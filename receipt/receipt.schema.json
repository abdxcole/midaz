{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdxcole/margen-hackathon-2026/receipt/receipt.schema.json",
  "title": "Recibo MIDAZ (HU-03)",
  "description": "Un recibo por cada frase con numero. Sin recibo, la frase no se muestra.",
  "type": "object",
  "required": ["id", "claim", "sql", "sql_file", "view", "sources", "row_count", "executed_at",
               "execution_ms", "engine", "data_quality_warnings", "verifier", "sample_data"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^R-[A-Z0-9-]+$"},
    "claim": {"type": "string", "minLength": 1, "description": "La frase exacta que ve Dona Marta"},
    "sql": {"type": "string", "minLength": 1, "description": "SQL exacta ejecutada"},
    "sql_file": {"type": "string", "description": "Archivo en sql/ de donde salio"},
    "view": {
      "type": "object",
      "required": ["name", "definition_file", "definition_sql", "business_terms"],
      "properties": {
        "name": {"type": "string"},
        "definition_file": {"type": "string"},
        "definition_sql": {"type": "string"},
        "business_terms": {
          "type": "object",
          "required": ["margen", "costo_operativo", "producto_estrella", "ganancia_bruta"],
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema", "table", "columns"],
        "properties": {
          "schema": {"type": "string"}, "table": {"type": "string"}, "file": {"type": "string"},
          "columns": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "row_count": {"type": "integer", "minimum": 0},
    "executed_at": {"type": "string", "format": "date-time"},
    "execution_ms": {"type": "number", "minimum": 0},
    "engine": {"type": "string", "enum": ["sqlite-local-standin", "zetaris"]},
    "data_quality_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "products", "count", "detail"],
        "properties": {
          "code": {"type": "string", "enum": ["sin_costo", "precio_bajo_costo", "ventas_negativas"]},
          "products": {"type": "integer"}, "count": {"type": "integer"}, "detail": {"type": "string"}
        }
      }
    },
    "verifier": {
      "type": "object",
      "required": ["verdict", "by", "checked_at", "notes"],
      "properties": {
        "verdict": {"type": "string", "enum": ["pendiente", "confirmado", "rechazado"]},
        "by": {"type": ["string", "null"], "description": "Modelo Nemotron (lane fijo) o persona"},
        "checked_at": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "sample_data": {"type": "boolean"},
    "redaccion": {
      "type": "object",
      "description": "HU-01 (opcional): quien redacto el texto. Nemotron via Nightshift, lane fijo.",
      "required": ["provider", "lane", "model"],
      "properties": {
        "provider": {"type": "string"},
        "lane": {"type": ["string", "null"]},
        "model": {"type": "string"},
        "frases_quitadas": {"type": "integer"}
      }
    }
  }
}
