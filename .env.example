# Copiar a .env (NO se commitea). Solo nombres; los valores viven en tu maquina.
# Zetaris REST (docs/08-hu00-zetaris.md)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
# Opcional: reescribe prefijos de esquema al pasar de SQLite a Zetaris
MIDAZ_SCHEMA_MAP=
# Motor: local (sustituto SQLite, por defecto) | zetaris
MIDAZ_ENGINE=
# Zetaris: cte (vista como CTE, por defecto) | view (vista creada en Zetaris)
MIDAZ_ZETARIS_VIEW=
# La llave NVIDIA NO va aca: vive solo en Providers de Nightshift.
# Meterless Nightshift (OpenAI-compatible). Solo nombres; valores en tu .env local o en la config de la app.
NIGHTSHIFT_URL=
NIGHTSHIFT_TOKEN=
# Token del Meterless Runtime: va en Nightshift y en la config de la app, nunca en la herramienta de codigo.
METERLESS_RUNTIME_TOKEN=
# Lane Nemotron FIJO (id copiado de GET /v1/models de Nightshift). Nunca meterless/auto.
MIDAZ_NEMOTRON_LANE=
# H-MEM: archivo de memoria (por defecto out/hmem/memoria.json, ignorado por git)
MIDAZ_HMEM_PATH=
# NVIDIA_API_KEY: NO se pone aca; va solo en Nightshift > Providers.
